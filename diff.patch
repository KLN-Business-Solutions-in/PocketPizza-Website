+        // 500/network = infra error ΓåÆ treat as ok (don't redirect).
+        if (
+          err?.status === 401 &&
+          (err?.code === "AUTHENTICATION_REQUIRED" || err?.code === "AUTHENTICATION_INVALID")
+        ) {
+          return { ok: false };
+        }
+        // Any other error: resolve as ok:true so dashboard renders its own error state.
+        return { ok: true };
