{
  "name": "pokket-pizza-backend",
  "version": "0.0.1",
  "description": "Pokket Pizza REST API (Hono on Node.js and Cloudflare Workers)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "wrangler dev",
    "build": "prisma generate --config ../prisma7.config.ts && tsc",
    "typecheck": "tsc --noEmit",
    "deploy": "prisma generate --config ../prisma7.config.ts && wrangler deploy",
    "start": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "test": "node --import tsx --test src/utils/deliveryDistance.test.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "@pokket-pizza/contract": "0.0.1",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.4.5",
    "hono": "^4.13.13",
    "jose": "^5.9.0",
    "pg": "^8.23.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "prettier": "^3.3.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.151.2"
  }
}
