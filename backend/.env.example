NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:pass@localhost:5432/pokket_pizza
JWT_SECRET=
JWT_ISSUER=pokket-pizza
JWT_AUDIENCE=pokket-pizza-admin
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5500,http://localhost:5501
# Shop map-pin coordinates (server-side only, never exposed to the browser).
# Used for the straight-line delivery fee: free within 1.5 km, ₹30 beyond.
# Replace with the actual pin before deploying a different shop location.
SHOP_LATITUDE=18.456165955627945
SHOP_LONGITUDE=73.86959266088635
# Twilio WhatsApp — Content API (pre-approved templates)
# Account SID / Auth Token: Twilio Console → Account Info (server env only, never in git)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp-enabled sender, e.164 or whatsapp:+<e.164>
TWILIO_WHATSAPP_NUMBER=
# Content SIDs of the approved templates (Content Editor → SID)
CUSTOMER_TEMPLATE_SID=
ADMIN_TEMPLATE_SID=
LOG_LEVEL=info
