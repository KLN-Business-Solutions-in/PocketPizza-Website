{
  "name": "pokket-pizza",
  "version": "0.0.1",
  "private": true,
  "description": "Pokket Pizza — Official Website Monorepo",
  "workspaces": [
    "frontend",
    "backend",
    "shared/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend -w frontend\" \"npm run dev:backend\"",
    "build": "npm run build:frontend && npm run build:backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "zod": "^4.6.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "argon2@0.31.2": true
  }
}
